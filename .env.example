APP_NAME="Rathinam Global University"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=rathinamglobal_edu
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Rathinam Global University ---------------------------------------------
RGU_CANONICAL_URL=https://rathinamglobal.edu.in
RGU_GA4_ID=G-EKNZR4B5B8
RGU_META_PIXEL_ID=1081423431094840

# AC bus registration (/acbus) -> Google Apps Script web app (/exec URL).
# Deploy the script as "Execute as: Me" and "Who has access: Anyone".
BUS_REGISTRATION_APPS_SCRIPT_URL=
TURNSTILE_SITE_KEY=0x4AAAAAAECxzNbaUSYB2bse
# Leave empty to skip the server-side CAPTCHA check.
TURNSTILE_SECRET_KEY=

# ESG / ESIA enquiry leads -> Google Apps Script web app (/exec URL).
BROCHURE_LEADS_APPS_SCRIPT_URL=

# AI FAQ & voice assistant (config/assistant.php) ---------------------------
ASSISTANT_ENABLED=true
ASSISTANT_DEFAULT_LANGUAGE=ta
ASSISTANT_MAX_CONTEXT_MESSAGES=6
ASSISTANT_RETRIEVAL_LIMIT=5
# Chunks scoring below this (0-1) are treated as "no verified information".
ASSISTANT_MIN_RELEVANCE_SCORE=0.25
ASSISTANT_MAX_MESSAGE_LENGTH=500

# Gemini (key from https://aistudio.google.com/apikey). Set GEMINI_MODEL to a
# current model id listed in AI Studio; it is deliberately not hardcoded.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=20
GEMINI_MAX_OUTPUT_TOKENS=700
GEMINI_RETRIES=2

# Google Cloud Text-to-Speech / Speech-to-Text. Use EITHER a service-account
# JSON file (recommended) OR an API key restricted to those two APIs.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_API_KEY=
GOOGLE_TTS_VOICE_TA=ta-IN-Chirp3-HD-Aoede
GOOGLE_TTS_VOICE_EN=en-IN-Chirp3-HD-Aoede
GOOGLE_TTS_SPEAKING_RATE=1.0
