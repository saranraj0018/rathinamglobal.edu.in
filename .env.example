# Website voice assistant ---------------------------------------------------
# Works with no AI key: answers then come straight from the knowledge base
# (resources/data/voice-assistant.php + FAQ + school pages), at no cost.
# For natural English/Tamil answers, set any OpenAI-compatible provider.
# Free-tier example, Google Gemini (key from https://aistudio.google.com/apikey;
# free-tier prompts may be used by Google to improve its products):
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=<a current Gemini Flash model id listed in AI Studio>
# Free-tier example, Groq (key from https://console.groq.com/keys):
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=<a model id from https://console.groq.com/docs/models>
VOICE_ASSISTANT_ENABLED=true
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
# Shown to visitors in the privacy notice, e.g. "Google Gemini".
AI_PROVIDER_NAME=
AI_TIMEOUT=20
AI_MAX_TOKENS=800
# Google Cloud Text-to-Speech, so Tamil answers are spoken on computers with
# no Tamil voice. Create an API key restricted to the "Cloud Text-to-Speech
# API" in a Google Cloud project with billing enabled (monthly free tier).
GOOGLE_TTS_KEY=
